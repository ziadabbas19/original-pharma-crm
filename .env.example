# Copy to .env (or run scripts/dev-setup.sh, which does it for you).
# Used by docker-compose.yml for the local PostgreSQL container.
POSTGRES_DB=original_pharma
POSTGRES_USER=pharma
POSTGRES_PASSWORD=change-me
# 5433 so it never clashes with a PostgreSQL installed on the host (5432).
POSTGRES_PORT=5433
REDIS_PORT=6379

# Host port of the optional containerised API (podman compose --profile api up -d --build).
# Its settings live in .env.production.local (copy .env.production.example).
# API_PORT=8080
