# Copy to .env.local and adjust. Only VITE_* values reach the browser bundle.

# Absolute API origin. Leave empty for the web dev server (it proxies /api and /hubs).
# Android emulator against a local API: http://10.0.2.2:5080
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api and /hubs.
VITE_DEV_API_TARGET=http://localhost:5080

# Set to true once google-services.json is in FRONTEND/android/app (Firebase project).
# Without it, registering for push crashes the Android app, so it stays off by default.
VITE_FCM_ENABLED=false
