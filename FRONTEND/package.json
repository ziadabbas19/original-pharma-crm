{
  "name": "original-pharma-crm-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Original Pharma CRM: admin dashboard and medical rep app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "build:production": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b",
    "lint": "eslint . && npm run check:emoji",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:ui": "node tests/ui/delete-confirmation.mjs",
    "test:ui:visits": "node tests/ui/visit-flow.mjs",
    "test:ui:suspicious": "node tests/ui/suspicious-activity.mjs",
    "test:ui:errors": "node tests/ui/error-handling.mjs",
    "test:ui:phone": "node tests/ui/phone-screens.mjs",
    "test:ui:expenses": "node tests/ui/expenses-flow.mjs",
    "routes:generate": "tsr generate",
    "api:generate": "orval --config orval.config.ts",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android": "npm run cap:sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@transistorsoft/capacitor-background-fetch": "^8.1.4",
    "@transistorsoft/capacitor-background-geolocation": "^9.7.2",
    "capacitor-native-settings": "^8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.16.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-redux": "^9.3.1",
    "tailwind-merge": "^3.7.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "orval": "^8.48.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
