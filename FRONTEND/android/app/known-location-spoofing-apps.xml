<?xml version="1.0" encoding="utf-8"?>
<!--
  Known location spoofing apps and root tools. Best effort: package names change and new apps
  appear, so finding none of them is never proof that a phone is honest.

  This is the only copy of the list. The build (app/build.gradle) uses it twice:
    - merged into the app manifest, so Android lets the app see exactly these packages
      (no QUERY_ALL_PACKAGES, which Google Play restricts);
    - read into BuildConfig.KNOWN_SPOOFING_APPS / KNOWN_ROOT_APPS for DeviceSignalsPlugin.

  To update: add or remove <package> lines under the right "section:" comment and build a new APK.
  Keep one package per line. Check new names on the Play Store listing before adding them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <!-- section: spoofing -->
        <package android:name="com.lexa.fakegps" />
        <package android:name="com.incorporateapps.fakegps.fre" />
        <package android:name="com.blogspot.newapphorizons.fakegps" />
        <package android:name="com.theappninjas.fakegpsjoystick" />
        <package android:name="com.theappninjas.gpsjoystick" />
        <package android:name="com.rosteam.gpsemulator" />
        <package android:name="ru.gavrikov.mocklocations" />
        <package android:name="com.marlon.floating.fake.location" />
        <package android:name="org.hola.gpslocation" />
        <package android:name="com.evezzon.fakegps" />
        <package android:name="com.gsmartstudio.fakegps" />
        <package android:name="com.just4funtools.fakegpslocationprofessional" />
        <package android:name="com.fakegps.mock" />
        <package android:name="com.lkr.fakelocation" />
        <package android:name="com.usefullapps.fakegpslocationpro" />
        <package android:name="com.divi.fakeGPS" />
        <package android:name="com.pe.fakegps" />
        <package android:name="com.fly.gps" />

        <!-- section: root -->
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.yellowes.su" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingo.root" />
        <package android:name="com.smedialink.oneclickroot" />
        <package android:name="com.zhiqupk.root.global" />
        <package android:name="com.alephzain.framaroot" />
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="org.lsposed.manager" />
        <package android:name="io.github.lsposed.manager" />
        <package android:name="me.weishu.exp" />
        <package android:name="com.saurik.substrate" />
    </queries>
</manifest>
