# Every production setting, without values. Full descriptions: docs/deployment.md
# Local production-like run: copy to .env.production.local (git-ignored) and fill it in.
# On Railway, add the API section as service variables instead.

# ---------------------------------------------------------------------------
# API: required
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Host=...;Port=5432;Database=...;Username=...;Password=...
ConnectionStrings__Postgres=
# host:6379,password=...
ConnectionStrings__Redis=

# openssl rand -base64 48
Jwt__SigningKey=
Jwt__Issuer=
Jwt__Audience=

# Public HTTPS origin of the API, e.g. https://api.your-domain
App__PublicBaseUrl=
# Web app origin, plus https://localhost for the Android app (comma-separated)
Cors__AllowedOrigins=

# Uploads folder on the data volume. Mount the volume at /var/lib/original-pharma
FileStorage__RootPath=/var/lib/original-pharma/uploads

# The proxy in front of the API. Railway: TrustAllProxies=true and ClientIpHeader=X-Real-IP
ForwardedHeaders__TrustAllProxies=
ForwardedHeaders__ClientIpHeader=

# First administrator. Needed until an admin exists, then remove both.
Seed__AdminEmail=
Seed__AdminPassword=

# ---------------------------------------------------------------------------
# API: optional (defaults shown)
# ---------------------------------------------------------------------------
# Set by Railway automatically
# PORT=8080
# Defaults to a "keys" folder next to FileStorage__RootPath. Must stay outside the uploads folder
# DataProtection__KeysPath=/var/lib/original-pharma/keys
# Serilog__MinimumLevel__Default=Information
# Seed__AdminFullName=System Admin
# One-time admin password reset with Seed__AdminEmail and Seed__AdminPassword. Remove all three right after
# Seed__ResetAdminPassword=true
# Database__MigrateOnStartup=true
# Expenses__EditableDays=45
# ForwardedHeaders__ForwardLimit=1
# ForwardedHeaders__KnownProxies=
# ForwardedHeaders__KnownNetworks=
# Auth__SessionDays=30
# Auth__SessionMaxDays=90
# Auth__RefreshReuseGraceSeconds=10
# Auth__RefreshCookie__Domain=
# Auth__RefreshCookie__Secure=true
# Auth__RefreshCookie__SameSite=Strict
# AllowedHosts=
# DeveloperPages__Enabled=false
# SignalR__UseRedisBackplane=false
# RAILWAY_RUN_UID=0

# ---------------------------------------------------------------------------
# Web and Android build (set where `npm run build:production` runs)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
# VITE_MAP_TILE_SIZE=256
# VITE_MAP_TILE_MAX_ZOOM=19
# VITE_FCM_ENABLED=false

# ---------------------------------------------------------------------------
# Android release signing (set where the release is built, never committed)
# ---------------------------------------------------------------------------
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
