{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "original-pharma-api",
    "Audience": "original-pharma-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "SignalR": {
    "UseRedisBackplane": false
  },
  "Seed": {
    "AdminEmail": "admin@originalpharma.local",
    "AdminFullName": "System Admin",
    "DemoData": false
  },
  "Tracking": {
    "ConsentVersion": "2026-11-v1",
    "MaxPointsPerBatch": 500,
    "OnlineWindowMinutes": 12,
    "TrackingLostAfterMinutes": 30,
    "LiveViewTtlSeconds": 120,
    "RequireOnboardedDevice": true,
    "Normal": {
      "DistanceFilterMeters": 75,
      "UploadBatchSize": 10,
      "UploadIntervalSeconds": 300,
      "HeartbeatIntervalSeconds": 600
    },
    "Live": {
      "DistanceFilterMeters": 20,
      "UploadBatchSize": 1,
      "UploadIntervalSeconds": 15,
      "HeartbeatIntervalSeconds": 60
    },
    "Anomalies": {
      "MaxSpeedKmh": 200,
      "TeleportDistanceMeters": 20000,
      "TeleportWindowSeconds": 300,
      "MinJumpMeters": 300,
      "SuspiciousAccuracyMeters": 1.5,
      "RepeatedAccuracyRun": 6,
      "MaxClockDriftSeconds": 300,
      "IpMismatchKm": 500,
      "FlagThreshold": 50
    }
  },
  "Stats": {
    "TimeZone": "Africa/Cairo",
    "LowStockThreshold": 10,
    "CacheSeconds": 60,
    "MaxRangeDays": 366
  },
  "Visits": {
    "MaxAccuracyMeters": 100,
    "MaxAccuracyAllowanceMeters": 50,
    "RejectOutsideGeofence": true,
    "MaxPhotoBytes": 8388608,
    "ContentEditHours": 24
  },
  "FileStorage": {
    "RootPath": ""
  },
  "Images": {
    "MaxBytes": 5242880,
    "MaxPixels": 40000000
  },
  "PlayIntegrity": {
    "PackageName": "com.originalpharma.crm"
  }
}
